APP_NAME="SecurePath Attendance API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Damascus

FACE_AI_SERVICE_URL=http://ai-service:8001
FACE_AI_SERVICE_TOKEN=
FACE_AI_SERVICE_TIMEOUT=45

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=attendance_system
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@attendance.local"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_TOKEN_EXPIRATION=720
LOGIN_RATE_LIMIT=5
DUPLICATE_RECOGNITION_WINDOW_SECONDS=60
RECOGNITION_MINIMUM_CONFIDENCE=0.85
RECOGNITION_REVIEW_THRESHOLD=0.75
PAYROLL_CURRENCY=USD
